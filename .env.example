# Read by docker-compose.yml to configure the Postgres and RabbitMQ containers
# and to build the connection URLs it passes to each service.
# Use simple values: special characters like @ : / in a password break the URLs.
POSTGRES_USER=streamforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=streamforge
RABBITMQ_USER=streamforge
RABBITMQ_PASSWORD=change-me