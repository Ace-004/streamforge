PORT=4000
NODE_ENV=development

# Used for signing auth tokens; use a long random string
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Allowed frontend origin (CORS / cookies)
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://user:password@localhost:5432/streamforge
REDIS_URL=redis://localhost:6379

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# false switches the UI to polling instead of WebSockets
ENABLE_WEBSOCKETS=true